PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=isp_ticketing_db
DB_SYNCHRONIZE=true
DB_LOGGING=true

# JWT Configuration
JWT_SECRET=isp_super_secure_jwt_secret_key_2026_dev
JWT_EXPIRES_IN=7d

# AI (Gemini) Configuration
# Get a key at https://aistudio.google.com/apikey (free tier available)
# AI_MODEL: gemini-3.1-flash-lite is fast/cheap and fits classification;
# 'gemini-flash-latest' is a stable alias to the current flagship Flash model.
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.1-flash-lite
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=1
AI_RETRY_DELAY_MS=2000
AI_ENABLED=true

REDIS_HOST=your-endpoint.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_upstash_password
REDIS_TLS=true

